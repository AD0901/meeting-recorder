# 复制成 .env 后填写（.env 已在 .gitignore 中，不会进 git）
#   cp .env.example .env

# ---------- 阿里云账号（RAM 子账号的 AccessKey，不是登录名/密码） ----------
# RAM 控制台 → 用户 → 你的子账号 → 创建 AccessKey
# 该子账号需要权限：AliyunTingwuFullAccess、AliyunOSSFullAccess（或只授权下面这个 bucket）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---------- 通义听悟 ----------
# 听悟控制台（https://tingwu.console.aliyun.com）→ 开通服务 → 创建项目 → 复制 AppKey
TINGWU_APPKEY=
TINGWU_REGION=cn-beijing

# ---------- 对象存储 OSS（听悟只接受可访问的音频 URL，所以先传到 OSS，再生成临时签名链接） ----------
# OSS 控制台 → 创建 Bucket（私有读写即可，推荐与听悟同地域：华北2 北京）
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PREFIX=meeting-recorder/

# ---------- 存储方式 ----------
# local = 录音和纪要只存在服务端本机 data/；oss = 同时归档到上面的 OSS bucket
STORAGE=local

# ---------- 服务端（里程碑 3） ----------
# 转写服务：tingwu = 通义听悟；none = 只收录音不转写
ASR_PROVIDER=tingwu
# 设备上传时要带的口令（设备配网页里填同一个）；留空 = 不校验
API_TOKEN=
# 纪要生成后在本机弹通知并打开浏览器（服务端跑在自己 Mac 上时有用）
AUTO_OPEN=1
PUBLIC_URL=http://localhost:8000
# 网页（会议列表、纪要）登录用户名和密码；部署到云上时必须设置，本机用可以留空
WEB_USER=
WEB_PASSWORD=

# ---------- LLM（可选：上传会议资料生成增强纪要时用，不启用可留空） ----------
# 当前：千问AI平台（platform.qianwenai.com，qwen3.7-plus 有 1M tokens 免费额度）
# 阿里云百炼：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1，model=qwen-plus
# DeepSeek：base_url=https://api.deepseek.com，model=deepseek-flash
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
