/*
 * 可选：出厂默认的 Wi-Fi 和服务器地址。复制成 secrets.h 后填写（secrets.h 不进 git）。
 *     cp secrets.h.example secrets.h
 *
 * 不建这个文件也可以：设备第一次开机会进入配网模式，用手机连设备热点后在网页里填，
 * 填过的内容存在设备 NVS 里，优先于这里的默认值。
 */
#pragma once

#define DEFAULT_WIFI_SSID   "your-ssid"
#define DEFAULT_WIFI_PASS   "your-password"
#define DEFAULT_SERVER_URL  "http://your-mac.local:8000"
#define DEFAULT_API_TOKEN   ""
